{
  "name": "servvo-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Servvo MVP Customer App - White-label mobile experience for homeowners",
  "workspaces": [
    "apps/mobile",
    "apps/backend",
    "apps/web"
  ],
  "scripts": {
    "mobile:start": "npm run dev -w apps/mobile",
    "backend:start": "npm run start -w apps/backend",
    "backend:dev": "npm run dev -w apps/backend",
    "dev": "npm run dev --workspaces --if-present",
    "dev:mobile": "npm run dev -w apps/mobile",
    "dev:backend": "npm run dev -w apps/backend",
    "build": "npm run build --workspaces --if-present",
    "build:mobile": "npm run build -w apps/mobile",
    "build:backend": "npm run build -w apps/backend",
    "test": "npm run test --workspaces --if-present",
    "test:mobile": "npm run test -w apps/mobile",
    "test:backend": "npm run test -w apps/backend",
    "lint": "npm run lint --workspaces --if-present",
    "lint:mobile": "npm run lint -w apps/mobile",
    "lint:backend": "npm run lint -w apps/backend",
    "web:dev": "npm run dev -w apps/web",
    "web:build": "npm run build -w apps/web",
    "web:test": "npm run test -w apps/web",
    "clean": "rm -rf node_modules apps/mobile/node_modules apps/backend/node_modules apps/web/node_modules"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
